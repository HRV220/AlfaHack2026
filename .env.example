# Пример переменных окружения для `make up`. Скопируйте в `.env` и при необходимости измените.
# Без `.env` всё работает на значениях по умолчанию для разработки (они же указаны ниже).
# Случайные пароли и JWT-секрет создаёт необязательный `scripts/bootstrap.sh` (Windows:
# `scripts/bootstrap.ps1`); запускайте его до первого `make up`: пароли PostgreSQL и MinIO
# запоминаются в томах при первой инициализации.
# Секретов здесь нет: пароли ниже — учебные значения для локального стенда. Проверяемая версия
# не требует ключей и доступа к сети (NFR-19).

# --- Режим по умолчанию: локальная LLM, ассистент включён (архитектура 16) ---
LLM_PROVIDER=local
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
ASSISTANT_ENABLED=true
# Демо-задержка статуса «Проверка» заявки перед решением, секунды (SC-08: решение за ≤ 60 с)
CHECKING_DELAY_SEC=5
LOG_LEVEL=INFO

# --- Хранилища (учебные значения для локального стенда) ---
# Пароль PostgreSQL подставляется в адрес MLflow без кодирования: без символов @ / : # ? %
POSTGRES_USER=cabinet
POSTGRES_PASSWORD=cabinet_dev
# Пароли ролей схем БД (E02-03); init задаёт их при каждом запуске (по умолчанию — dev-значения)
DB_CORE_PASSWORD=core_dev
DB_KB_PASSWORD=kb_dev
DB_BANK_PASSWORD=bank_dev
DB_ML_PASSWORD=ml_dev
DB_DOCS_PASSWORD=docs_dev
POSTGRES_DB=cabinet
MINIO_ROOT_USER=cabinet
MINIO_ROOT_PASSWORD=cabinet_dev_secret
# Ключ подписи сессий (JWT); используется с эпика E04
JWT_SECRET=dev_jwt_signing_key_for_local_stand

# --- Порты на хосте (только 127.0.0.1) ---
EDGE_HTTPS_PORT=8443
CONSOLE_PORT=8081
MLFLOW_PORT=5000
