{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.smart-credit.local/events/bank.transactions_updated.schema.json",
  "title": "data события bank.transactions_updated",
  "description": "bank-sim → ml-service. Появились операции по счетам компании (первый вход или обновление).",
  "type": "object",
  "properties": {
    "inn": {
      "$ref": "../schemas/domain.schema.json#/$defs/Inn"
    },
    "account_ids": {
      "type": "array",
      "items": {
        "$ref": "../schemas/domain.schema.json#/$defs/Uuid"
      },
      "minItems": 1
    },
    "period_from": {
      "$ref": "../schemas/domain.schema.json#/$defs/Date"
    },
    "period_to": {
      "$ref": "../schemas/domain.schema.json#/$defs/Date"
    },
    "new_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "inn",
    "account_ids",
    "period_from",
    "period_to",
    "new_count"
  ],
  "additionalProperties": false
}