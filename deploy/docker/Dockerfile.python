# Образ сервиса: docker build -f deploy/docker/Dockerfile.python \
#   --build-arg SERVICE=core-api --build-arg APP_MODULE=core_api.main:app .
# Контекст сборки — корень репозитория; один образ на сервис, режим задаёт SERVICE_MODE.

ARG PYTHON_IMAGE=python:3.12.8-slim-bookworm

FROM ${PYTHON_IMAGE} AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
ARG SERVICE
COPY pyproject.toml uv.lock .python-version ./
COPY libs ./libs
COPY services ./services
COPY web ./web
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable --package "${SERVICE}"

FROM ${PYTHON_IMAGE} AS runtime
ARG APT_PACKAGES=""
ARG APP_MODULE
RUN if [ -n "${APT_PACKAGES}" ]; then \
      apt-get update && apt-get install -y --no-install-recommends ${APT_PACKAGES} \
      && rm -rf /var/lib/apt/lists/*; \
    fi \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app
COPY --from=builder /app/.venv /app/.venv
# Контракт событий — единственный источник схем (docs/contracts), без копии в репозитории
COPY docs/contracts/events /app/contracts/events
COPY docs/contracts/schemas /app/contracts/schemas
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_MODULE=${APP_MODULE} \
    CONTRACTS_DIR=/app/contracts \
    SERVICE_MODE=api \
    PORT=8000
USER app
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-m", "cabinet_common.entrypoint", "--healthcheck"]
ENTRYPOINT ["python", "-m", "cabinet_common.entrypoint"]
