# Образ MLflow-сервера: официальный образ не содержит драйверов PostgreSQL и S3.
#   docker build -f deploy/docker/Dockerfile.mlflow -t alfacase/mlflow:dev .
# Версии закреплены (NFR-20); сборка требует сети один раз, запуск — нет.

ARG PYTHON_IMAGE=python:3.12.8-slim-bookworm
FROM ${PYTHON_IMAGE}

ARG MLFLOW_VERSION=2.19.0
ARG PSYCOPG2_VERSION=2.9.10
ARG BOTO3_VERSION=1.35.90
# MLflow 2.19 несовместим с SQLAlchemy 2.1+ (нет FallbackAsyncAdaptedQueuePool)
ARG SQLALCHEMY_VERSION=2.0.36

RUN pip install --no-cache-dir \
      "mlflow==${MLFLOW_VERSION}" \
      "psycopg2-binary==${PSYCOPG2_VERSION}" \
      "boto3==${BOTO3_VERSION}" \
      "sqlalchemy==${SQLALCHEMY_VERSION}" \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

USER app
EXPOSE 5000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
    CMD ["python", "-c", "import urllib.request as u; u.urlopen('http://127.0.0.1:5000/health', timeout=3)"]
ENTRYPOINT ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000"]
